# Copy this file to .env before running `docker compose up`.
# Values shown are the defaults — edit only what you need to change.

# MySQL credentials (used by both app and db containers)
MYSQL_USER=statedecoded
MYSQL_PASSWORD=statedecoded
MYSQL_ROOT_PASSWORD=rootpassword

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Site identity (optional — sensible defaults are baked in)
# SITE_TITLE=The State Decoded
# PLACE_NAME=State
# LAWS_NAME=Code of State

# Search engine (SqlSearchEngine is the only supported option in Docker)
SEARCH_ENGINE=SqlSearchEngine

# Memcached (only needed when running `--profile cache`)
# CACHE_HOST=memcached
# CACHE_PORT=11211

# Cloudflare (only if the site is behind Cloudflare). The token needs only the
# "Zone > Cache Purge" permission; with it, Cloudflare's cache is emptied after
# each import. TRUSTED_PROXY=cloudflare makes Apache log and record visitors'
# real IP addresses instead of Cloudflare's.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# TRUSTED_PROXY=cloudflare

# How long pages may be cached, in seconds (defaults shown)
# CACHE_BROWSER_TTL=3600
# CACHE_SHARED_TTL=86400
# CACHE_CDN_TTL=2592000

# Debug verbosity: 1 (verbose) to 10 (quiet)
DEBUG_LEVEL=5
